# AI Providers (get keys from provider dashboards)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

GEMINI_API_KEY=AIza-your-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# Optional: Preferred provider order (comma-separated)
AI_PROVIDER_ORDER=openrouter,deepseek,gemini

# TTS/STT Preferences
TTS_ENGINE=pyttsx3          # pyttsx3 (offline) or gtts (online)
STT_ENGINE=vosk             # vosk (offline) or speechrecognition (online)
STT_LANGUAGE=en-us

# Audio Settings
MIC_INDEX=default           # ALSA device index or 'default'
VOLUME_STEP=10              # Volume change increment
cp .env.example .env
chmod 600 .env
